{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "me2listen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/lessons/*", "/sitemap.xml", "/robots.txt"]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "1059777304131-gour3h7dbrfe648mia9qvnj8peqep9qa.apps.googleusercontent.com",
    "APP_ORIGIN": "https://me2listen.kimmanhcuong96.workers.dev"
  },
  "r2_buckets": [
    { "binding": "LISTENING_AUDIO", "bucket_name": "me2listen-audio" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
