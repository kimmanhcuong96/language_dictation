{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "me2listen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/lessons/*", "/learn/*", "/en", "/en/*", "/ja", "/ja/*", "/zh", "/zh/*", "/sitemap.xml", "/robots.txt"]
  },
  "r2_buckets": [
    { "binding": "LISTENING_AUDIO", "bucket_name": "me2listen-audio" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
