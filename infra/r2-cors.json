{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "https://your-app.example.com"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
