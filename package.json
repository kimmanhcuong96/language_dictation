{
  "name": "echo-type-dictation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "cf:types": "wrangler types",
    "cf:dev": "pnpm build && wrangler dev",
    "cf:deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply echotype-db --local",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "jsdom": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
